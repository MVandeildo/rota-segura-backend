const pool = require("../config/database");

const buscarPorEmail = async (email) => {
    const resultado = await pool.query(
        `SELECT id, email, password, verified, refresh_token
         FROM usuarios
         WHERE email = $1`,
        [email]
    );

    return resultado.rows[0];
};

const buscarPorId = async (id) => {
    const resultado = await pool.query(
        `SELECT id, email, password, verified, refresh_token
         FROM usuarios
         WHERE id = $1`,
        [id]
    );

    return resultado.rows[0];
};

const criar = async (email, password) => {
    const resultado = await pool.query(
        `INSERT INTO usuarios (email, password)
         VALUES ($1, $2)
         RETURNING id, email, verified, refresh_token`,
        [email, password]
    );

    return resultado.rows[0];
};

const atualizarRefreshToken = async (id, refreshToken) => {
    const resultado = await pool.query(
        `UPDATE usuarios
         SET refresh_token = $1
         WHERE id = $2
         RETURNING id, email, verified, refresh_token`,
        [refreshToken, id]
    );

    return resultado.rows[0];
};

module.exports = {
    buscarPorEmail,
    buscarPorId,
    criar,
    atualizarRefreshToken,
};
